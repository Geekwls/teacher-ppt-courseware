{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.teaching.org/v1/lesson-plan.schema.json",
  "title": "LessonPlanAST",
  "description": "小学课时教学计划内容抽象语法树契约 (v1.0.0) —— 纯教学内容与认知过程，不含任何展示坐标与样式",
  "type": "object",
  "required": [
    "schema_version",
    "lesson_id",
    "meta",
    "objectives",
    "teaching_sequence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "契约大版本号，当前统一为 1.0.0"
    },
    "lesson_id": {
      "type": "string",
      "description": "标准课时全局唯一标识，如 mat-g3-t1-u04-l01"
    },
    "meta": {
      "type": "object",
      "required": [
        "subject",
        "grade",
        "term",
        "unit",
        "topic",
        "lesson_type",
        "source_point_id"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "enum": ["math", "chinese", "english", "science"]
        },
        "grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "term": {
          "type": "string",
          "enum": ["term-1", "term-2"]
        },
        "unit": {
          "type": "integer",
          "minimum": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "description": "课题名；单字篇目（如《春》）同样合法"
        },
        "lesson_type": {
          "type": "string",
          "enum": [
            "concept_learning",
            "practice_consolidation",
            "unit_review",
            "experiment_inquiry",
            "reading_comprehension"
          ]
        },
        "source_point_id": {
          "type": "string",
          "description": "关联的教材知识库知识点 ID"
        },
        "class_period": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "description": "课时序号：同一课文分多课时施教时标注第几课时，封面副标题显示「第N课时」；缺省时单课时课件不标注"
        },
        "school": {
          "type": "string",
          "maxLength": 40,
          "description": "学校名称（可选），封面副标题展示；公开课场景使用"
        },
        "teacher": {
          "type": "string",
          "maxLength": 30,
          "description": "执教教师姓名（可选），封面副标题显示「执教：某某」"
        },
        "style": {
          "type": "string",
          "enum": ["clean", "warm", "chalk"],
          "default": "clean",
          "description": "视觉风格包: clean 清爽白 / warm 暖阳 / chalk 板书手账。只影响配色与装饰, 不改动页面结构与卡槽坐标"
        },
        "preset": {
          "type": "string",
          "enum": ["standard", "open_class", "review", "parent_meeting", "new_teacher"],
          "default": "standard",
          "description": "场景预设: standard 常态课 / open_class 公开课 / review 复习课 / parent_meeting 家长会 / new_teacher 新教师备课。联动结构、风格、密度与讲稿"
        },
        "layout_variants": {
          "type": "object",
          "description": "显式指定各页型的版式变体映射 (如 {'objectives_card': 'grid'})",
          "additionalProperties": { "type": "string" }
        },
        "duration_minutes": {
          "type": "integer",
          "default": 40
        }
      },
      "additionalProperties": false
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "assessment"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OBJ_\\d+$"
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "assessment": {
            "type": "string",
            "minLength": 5
          }
        },
        "additionalProperties": false
      }
    },
    "teaching_sequence": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "phase_id",
          "phase_name",
          "objective_ref",
          "content_block",
          "teacher_guidance"
        ],
        "properties": {
          "phase_id": {
            "type": "string",
            "pattern": "^phase_[a-z0-9_]+$"
          },
          "phase_name": {
            "type": "string"
          },
          "objective_ref": {
            "type": "string",
            "description": "指向 objectives 中的 id"
          },
          "content_block": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "contextual_problem",
                  "mathematical_reasoning",
                  "text_reading",
                  "character_writing",
                  "vocabulary_focus",
                  "worked_example",
                  "misconception_analysis",
                  "practice_challenge",
                  "rule_summary",
                  "activity_instruction",
                  "comparison_table",
                  "knowledge_tree",
                  "board_design",
                  "layered_homework"
                ]
              }
            },
            "additionalProperties": true
          },
          "student_action": {
            "type": "string"
          },
          "teacher_guidance": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 5,
                "description": "传统纯文本教师引导讲稿"
              },
              {
                "type": "object",
                "description": "结构化教案讲稿",
                "properties": {
                  "say": { "type": "string", "description": "教师讲授台词" },
                  "ask": { "type": "string", "description": "启发提问" },
                  "expected_answer": { "type": "string", "description": "预设学生回答" },
                  "transition": { "type": "string", "description": "环节过渡语" },
                  "timing": { "type": "string", "description": "建议时长，如 '3分钟'" }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "revision_history": {
      "type": "array",
      "description": "局部修订留痕（patch_courseware 写入），用于内容资产可追溯",
      "items": {
        "type": "object",
        "required": ["revised_at", "summary"],
        "properties": {
          "revised_at": { "type": "string", "description": "ISO 时间戳" },
          "summary": { "type": "string", "minLength": 1, "description": "本次修订摘要" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
