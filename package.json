{
  "name": "teacher-ppt-courseware",
  "version": "1.4.0",
  "description": "人教统编版课时 PPT 课件生成系统：LessonPlan AST → 教学门禁 → 表现规划 → 确定性 PPTX 渲染",
  "scripts": {
    "query": "node plugin/skills/lesson-courseware/scripts/query_curriculum.js",
    "validate": "node plugin/skills/lesson-courseware/scripts/validate_lesson_plan.js",
    "render": "node plugin/skills/lesson-courseware/scripts/build_courseware.js",
    "build": "node plugin/skills/lesson-courseware/scripts/build_courseware.js",
    "patch": "node plugin/skills/lesson-courseware/scripts/patch_courseware.js",
    "update-skill": "node scripts/update_skill.js",
    "check-skill": "node scripts/update_skill.js --check",
    "check-sync": "node scripts/install_skill.js --check",
    "pull-skill": "node scripts/update_skill.js --pull",
    "acceptance": "node scripts/run_acceptance.js",
    "install-skill": "node scripts/install_skill.js",
    "audit-kb": "node scripts/audit_kb.js",
    "audit-kb:strict": "node scripts/audit_kb.js --strict",
    "test": "node --test \"test/unit/*.test.js\" \"test/contract/*.test.js\" && node scripts/run_acceptance.js && node scripts/audit_kb.js --strict",
    "test:unit": "node --test \"test/unit/*.test.js\" \"test/contract/*.test.js\"",
    "test:contract": "node --test \"test/contract/*.test.js\"",
    "test:update-snapshots": "node scripts/update_snapshots.js",
    "test:acceptance": "node scripts/run_acceptance.js",
    "test:matrix": "node scripts/run_acceptance.js --matrix",
    "test:all": "node --test \"test/unit/*.test.js\" \"test/contract/*.test.js\" && node scripts/run_acceptance.js --matrix && node scripts/audit_kb.js --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geekwls/teacher-ppt-courseware.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Geekwls/teacher-ppt-courseware/issues"
  },
  "homepage": "https://github.com/Geekwls/teacher-ppt-courseware#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  }
}
